  dialogueId: 1
  npcName: "\uC774\uB984 \uBAA8\uB97C \uC0DD\uC874\uC790"
  dialogueType: 0
  requiredQuestId: 
  requiredQuestState: 0
  dialogueLines:
  - "\uB0B4\uAC00 \uB4E3\uAE30\uB85C\uB294 \uAD6C\uC870 \uC2E0\uD638\uB97C \uBCF4\uB0B4\uBA74
    \uAD6C\uD558\uB7EC \uC624\uB294 \uC0AC\uB78C\uB4E4\uC774 \uC788\uB2E4\uACE0 \uD558\uB354\uAD70."
  - "\uC81C\uB300\uB85C \uB41C \uC2E0\uD638\uB97C \uBCF4\uB0B4\uB824\uBA74 \uBB54\uAC00
    \uB9CC\uB4E4\uC5B4\uC57C \uD560 \uAC70\uC57C."
  - "\uB098? \uB09C \uADF8\uB7F4 \uD798\uC774 \uC5C6\uC5B4. \uD558\uC9C0\uB9CC \uB10C
    \uB2E4\uB97C\uC9C0\uB3C4 \uBAA8\uB974\uC9C0."
  - "\uB124\uAC00 \uD0C8\uCD9C \uD560 \uC218 \uC788\uB2E4\uBA74... \uB2E4\uB978 \uC0DD\uC874\uC790\uB4E4\uC5D0\uAC8C\uB3C4
    \uD76C\uB9DD\uC774 \uC0DD\uAE38 \uAC70\uC57C."
