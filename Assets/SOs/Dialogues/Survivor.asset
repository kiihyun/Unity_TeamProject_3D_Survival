  dialogueId: 1
  npcName: "\uC774\uB984 \uBAA8\uB97C \uC0DD\uC874\uC790"
  dialogueType: 0
  requiredQuestId: 
  requiredQuestState: 0
  dialogueLines:
  - "\uB09C \uC774 \uC0AC\uD0DC\uAC00 \uCC98\uC74C \uD130\uC84C\uC744 \uB54C, \uB3C4\uC2DC\uC5D0
    \uC788\uC5C8\uC5B4. \uC0AC\uB78C\uB4E4\uC740 \uB274\uC2A4\uAC00 \uACFC\uC7A5\uC774\uB77C\uACE0
    \uD588\uC9C0.\n"
  - "\uBA87 \uC8FC \uB9CC\uC5D0 \uBCD1\uC6D0\uBD80\uD130 \uBB34\uB108\uC84C\uC5B4.
    \uAC10\uC5FC\uB41C \uC0AC\uB78C\uB4E4\uC740 \uB9D0 \uADF8\uB300\uB85C \uBBF8\uCCD0\uBC84\uB838\uACE0...
    \uADF8 \uD6C4\uB85C \uB3C4\uC2DC\uB294 \uADF8\uB0E5 \uC0AC\uB77C\uC84C\uC5B4."
  - "\uB0A8\uC740 \uC0AC\uB78C\uB4E4\uC740 \uB3C4\uB9DD \uCE58\uB2E4\uAC00 \uC774\uB807\uAC8C
    \uAD6C\uC11D\uC5D0 \uAC07\uD78C\uAC70\uC57C."
